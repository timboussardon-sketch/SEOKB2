# Base PostgreSQL (npm run db:start en crée une locale sur le port 5545)
DATABASE_URL=postgresql://agent@127.0.0.1:5545/agent_prospection

# Accès au tableau de bord (Basic auth). Obligatoire en production.
DASHBOARD_PASSWORD=

# URL publique https de l'application, pour les liens de pré-audit /r/<jeton>. Vide = pas de lien externe.
APP_PUBLIC_URL=

# Plafond de dépense quotidien, toutes campagnes confondues
MAX_DAILY_COST_USD=10
MAX_CONCURRENT_DOMAINS=3

# Claude : nécessaire pour les campagnes réelles. Sans clé, seul le mode simulation tourne.
ANTHROPIC_API_KEY=
# Modèle utilisé (découverte, mesure, analyse). Par défaut claude-opus-5-5.
CLAUDE_MODEL=
# Tarifs : ceux de l'API Claude sont intégrés (relevés le 2026-10-01). PRICING_JSON les remplace ou ajoute un modèle.
# PRICING_JSON={"<modèle>":{"input_per_mtok":0,"output_per_mtok":0,"web_search_per_call":0}}
PRICING_JSON=

# Taille du monde fictif du mode simulation
SIMULATION_WORLD_SIZE=60

# Gmail (relevé des réponses) : identifiant OAuth « application de bureau » de la console Google Cloud, API Gmail activée.
# Lecture seule : relève les réponses arrivées sur MAIL_REPLY_TO.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Envoi par Resend. Le domaine de MAIL_FROM doit être vérifié chez Resend.
RESEND_API_KEY=
MAIL_FROM=Prénom Nom <prenom@ton-domaine.fr>
MAIL_REPLY_TO=
MAX_SENDS_PER_DAY=20

# Claude sur le forfait Max (claude -p) au lieu de l'API facturée : CLAUDE_BACKEND=max. La mesure passe alors par Codex.
CLAUDE_BACKEND=

# Missions quotidiennes de l'agent (heure de Paris)
MISSIONS_ENABLED=false
# true : l'agent approuve et envoie seul les emails dont le contrôle factuel est vert
AUTO_SEND=false
DAILY_SENDS=10
MISSION_CITIES=Lyon
SEND_FROM_HOUR=9
SEND_UNTIL_HOUR=17
SEND_SPACING_MINUTES=20
REPORT_HOUR=18

# Identité de l'expéditeur : signature des emails, page de pré-audit, User-Agent du crawler.
# SENDER_NAME est obligatoire pour envoyer. SENDER_COMPANY et SENDER_URL sont facultatifs.
SENDER_NAME=
SENDER_COMPANY=
SENDER_URL=

# Bandeau facultatif sous l'email : nom d'un PNG déposé dans public/email/ (600 px de large, moins de 200 Ko). Vide : pas de bandeau.
EMAIL_BANNER_FILE=
