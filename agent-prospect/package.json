{
  "name": "agent-organikk-avocats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "./scripts/db-start.sh",
    "db:stop": "pg_ctl -D .pgdata stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "dev": "next dev -p 3456",
    "build": "next build",
    "start": "next start -p 3456",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "cheerio": "1.2.0",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "geist": "1.7.2",
    "next": "16.3.8",
    "openai": "7.25.0",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
